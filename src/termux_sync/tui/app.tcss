Screen {
    layout: vertical;
}

/* -- dashboard ------------------------------------------------------- */

#too-small {
    height: 1fr;
    border: round #ffd75f;
    content-align: center middle;
    text-align: center;
    color: #ffd75f;
}

#hero {
    height: 3;
    border: round #46dcff;
    padding: 0 1;
}

#hero-left {
    width: 60%;
    height: 1;
}

#hero-right {
    width: 40%;
    height: 1;
    text-align: right;
}

#stats {
    height: 3;
}

#stat-backups,
#stat-stored,
#stat-packages,
#stat-auto {
    width: 1fr;
    height: 3;
    padding: 0 1;
    border-title-style: bold;
}

#stat-backups {
    border: round #5fd75f;
    border-title-color: #5fd75f;
}

#stat-stored {
    border: round #46dcff;
    border-title-color: #46dcff;
}

#stat-packages {
    border: round #d278ff;
    border-title-color: #d278ff;
}

#stat-auto {
    border: round #ffd75f;
    border-title-color: #ffd75f;
}

#body {
    height: 1fr;
}

#actions-pane {
    width: 26;
    height: 1fr;
    border: round #46dcff;
    padding: 0 1;
}

#actions {
    height: 1fr;
    background: transparent;
    border: none;
}

#right {
    width: 1fr;
    height: 1fr;
}

#backups-pane {
    height: 55%;
    border: round #5fd75f;
}

#output-pane {
    height: 45%;
    border: round #d278ff;
}

#actions-pane.focused,
#backups-pane.focused,
#output-pane.focused {
    border: round #ffffff;
}

.pane-title {
    height: 1;
    text-style: bold;
}

#backups {
    height: 1fr;
}

#empty {
    height: 1fr;
    content-align: center middle;
    text-align: center;
    color: #8a8a8a;
}

#output {
    height: 1fr;
}

#footer-status,
#footer-hints {
    height: 1;
    padding: 0 1;
}

/* -- operation screen ------------------------------------------------ */

#title {
    height: 1;
    padding: 0 1;
    text-style: bold;
}

#stepper {
    height: auto;
    padding: 0 1;
}

#gauges {
    height: auto;
    padding: 0 1;
}

#log {
    height: 1fr;
    border: round $primary;
}

#failure {
    height: auto;
    padding: 0 1;
    background: $error 20%;
    color: $text;
}

#result {
    height: auto;
    padding: 0 1;
    background: $success 20%;
    color: $text;
}

#size-warning {
    height: auto;
    padding: 0 1;
    background: $warning 20%;
    color: $text;
}

/* -- modals ---------------------------------------------------------- */

ConfirmCancelModal {
    align: center middle;
}

#dialog {
    width: 44;
    height: auto;
    padding: 1 2;
    border: round $warning;
    background: $surface;
}

#summary {
    height: auto;
    padding: 0 1;
}

#diff {
    height: 1fr;
}

#confirm {
    margin: 0 1;
}

#hint {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

#help {
    height: auto;
}

.reduced-motion * {
    transition: none;
}
