Screen {
    layout: vertical;
}

#status {
    height: 1;
    padding: 0 1;
    background: $boost;
    color: $text;
}

#banner {
    height: auto;
    padding: 0 1;
    background: $warning 20%;
    color: $text;
}

#backups {
    height: 1fr;
}

#empty {
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
}

#title {
    height: 1;
    padding: 0 1;
    text-style: bold;
}

#stepper {
    height: auto;
    padding: 0 1;
}

#gauges {
    height: auto;
    padding: 0 1;
}

#log {
    height: 1fr;
    border: round $primary;
}

#failure {
    height: auto;
    padding: 0 1;
    background: $error 20%;
    color: $text;
}

#result {
    height: auto;
    padding: 0 1;
    background: $success 20%;
    color: $text;
}

#size-warning {
    height: auto;
    padding: 0 1;
    background: $warning 20%;
    color: $text;
}

ConfirmCancelModal {
    align: center middle;
}

#dialog {
    width: 44;
    height: auto;
    padding: 1 2;
    border: round $warning;
    background: $surface;
}
